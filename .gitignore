# Maven build output
target/

# Compiled class files
*.class

# IDE - VS Code
.vscode/
*.code-workspace

# IDE - IntelliJ (in case you switch later or a teammate uses it)
.idea/
*.iml
*.iws

# IDE - Eclipse
.project
.classpath
.settings/

# Playwright
node_modules/
playwright-report/
